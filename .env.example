# Drawesome — environment configuration (example). Copy to `.env` and fill in.
#
# When these are UNSET the app runs LOCAL-ONLY: drawing, layers, loops, gallery,
# and the Paint Space locker persist on-device and there is NO account or sync.
# Set them to turn PocketBase accounts on. See POCKETBASE_SETUP.md.

# --- Web app (Vite, build-time) ---
# The PUBLIC PocketBase URL the browser uses. Vite inlines this at build time, so
# changing it requires a rebuild (docker compose up -d --build app).
VITE_PB_URL=https://pb.drawesome.art

# --- Child-directed advertising (Vite, build-time) ---
# Full Google Ad Manager ad-unit paths. Leave empty until the account/creative
# review is approved; no Google script loads when both are blank. The second
# unit must be enabled for the limited-access H5 game manual interstitial format.
VITE_GAM_AD_UNIT_CHAT=
VITE_GAM_AD_UNIT_INTERSTITIAL=
VITE_AD_BREAK_MINUTES=10

# --- Realtime server (server.js, runtime) ---
# The server-internal PocketBase URL used to VALIDATE a signed-in user's token on
# the /ws handshake (it never holds any secret — just the public anon endpoint).
# In docker-compose this is set to http://pocketbase:8090 automatically; for a
# non-Docker local run, point it at your PocketBase instance:
PB_URL=http://127.0.0.1:8090

# --- Drawesome Family billing (server-only; never expose these to Vite) ---
PUBLIC_ORIGIN=https://drawesome.art
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FAMILY_MONTHLY=
STRIPE_PRICE_FAMILY_YEARLY=
# Keep false until test-mode checkout, webhooks, and the Portal smoke test pass.
# Turning it off later stops only NEW purchases; webhooks and billing management continue.
STRIPE_CHECKOUT_ENABLED=false
STRIPE_PAST_DUE_GRACE_HOURS=72
STRIPE_ALLOW_PROMOTION_CODES=false
STRIPE_AUTOMATIC_TAX=false
# Optional dedicated Portal configuration (bpc_...).
STRIPE_PORTAL_CONFIGURATION_ID=

# --- Cloudflare tunnel (only used with `docker compose --profile tunnel up`) ---
# The connector token for your existing drawesome.art tunnel. Get it with:
#   cloudflared tunnel token drawesome.art
# (or copy it from the Zero Trust dashboard's "cloudflared service install <TOKEN>"
# command). Secret — keep it in .env only.
TUNNEL_TOKEN=

# --- Mobile (Expo / EAS), for the future iOS app ---
# EXPO_PUBLIC_PB_URL=https://pb.drawesome.art
